# ── BASE DE DATOS ──────────────────────────────
DB_USER=agro
DB_PASSWORD=agro_pass_dev
DB_NAME=agrointeligente

# ── JWT ────────────────────────────────────────
# ⚠️ Cambia este valor en producción por una cadena aleatoria larga.
# Genera una con: openssl rand -base64 32
JWT_SECRET=cambia_este_secreto_en_produccion_min_32_chars
JWT_EXPIRES_IN=7d

# ── GESTOR DE ALERTAS ──────────────────────────
# Intervalo entre análisis automáticos (ms). 1800000 = 30 min
ALERTAS_INTERVAL_MS=1800000
